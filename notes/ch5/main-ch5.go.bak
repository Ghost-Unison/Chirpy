package main

import (
	"database/sql"
	"log"
	"net/http"
	"os"
	"sync/atomic"

	"github.com/Ghost-Unison/Chirpy/internal/database"
	"github.com/joho/godotenv"

	_ "github.com/lib/pq"
)

// keep track of the number of requests we've received
type apiConfig struct {
	fileserverHits atomic.Int32
	dbQueries      *database.Queries
}

func main() {
	godotenv.Load()
	//链接字符串中有@符号，需要转义
	dbURL := os.Getenv("DB_URL")
	/*
		sql.Open是GO标准库的数据库连接池，但只提供了比较底层的操作
		这是你不用 sqlc 时的写法——又长又容易出错
		row := db.QueryRowContext(ctx, "INSERT INTO users (...) VALUES (...) RETURNING *", email)
		var id, createdAt, updatedAt string
		row.Scan(&id, &createdAt, &updatedAt, &email)  // 手动 Scan，字段一多就容易搞错
	*/
	db, err := sql.Open("postgres", dbURL)
	if err != nil {
		log.Fatalf("failed to connect to db: %v\n", err)
	}

	/*
		所以这里用 sqlc 生成的 Queries 结构体把 *sql.DB 包装起来，提供类型安全的方法
		这里就不用手动 Scan 了，可以用sqlc 帮你生成好的方法，直接调用
		user, err := dbQueries.CreateUser(ctx, "someone@example.com")
		// 返回的 user 已经是 User 结构体，字段类型都是对的
		// user.ID 是 uuid.UUID，user.CreatedAt 是 time.Time

	*/
	dbQueries := database.New(db)

	/*
		Http的handler如果要访问数据库，handler中是看不到main()中的dbQueries的
		所以也把他放到apiConfig中，就像returnFileserverHits中通过apicfg来访问计数器一样
	*/
	apicfg := apiConfig{
		fileserverHits: atomic.Int32{},
		dbQueries:      dbQueries,
	}

	const filepathRoot = "."
	const port = "8080"

	// handler to route request
	mux := http.NewServeMux()
	mux.Handle("/app/", apicfg.middlewareMetricsInc(http.StripPrefix("/app", http.FileServer(http.Dir(filepathRoot)))))

	mux.HandleFunc("GET /api/healthz", healthCheckFunc)
	mux.HandleFunc("GET /admin/metrics", apicfg.returnFileserverHits)
	mux.HandleFunc("POST /admin/reset", apicfg.resetFileserverHits)

	mux.HandleFunc("POST /api/validate_chirp", validateFunc)

	//create new httpServer
	srv := &http.Server{
		Addr:    ":" + port,
		Handler: mux,
	}

	//start the server
	log.Printf("Serving files from %s on port: %s\n", filepathRoot, port)
	log.Fatal(srv.ListenAndServe())

}
